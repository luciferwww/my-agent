{
  "name": "my-agent",
  "version": "0.1.0",
  "description": "Personal AI Agent for learning purposes — exploring prompt building, environment tools, and agent architecture patterns",
  "type": "module",
  "bin": {
    "my-agent": "./dist/host/hosts/standalone/entry.js"
  },
  "workspaces": [
    "extensions/*"
  ],
  "exports": {
    "./extension-api": {
      "types": "./dist/host/extension/api/index.d.ts",
      "default": "./dist/host/extension/api/index.js"
    }
  },
  "files": [
    "dist/host",
    "extensions/copilot-relay-provider/copilot-relay-provider-unit.ts",
    "extensions/copilot-relay-provider/copilot-relay-provider.ts",
    "extensions/copilot-relay-provider/entry.ts",
    "extensions/copilot-relay-provider/extension.json",
    "extensions/copilot-relay-provider/index.ts",
    "extensions/copilot-relay-provider/model-metadata.ts",
    "extensions/copilot-relay-provider/package.json",
    "extensions/copilot-relay-provider/responses-client.ts",
    "extensions/copilot-relay-provider/types.ts"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && npm run build:host && npm run verify:host-build && npm run verify:relay",
    "build:host": "node -e \"require('node:fs').rmSync('dist/host', { recursive: true, force: true })\" && tsc -p tsconfig.host.json && node scripts/copy-host-assets.mjs",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:fitness": "vitest run --config vitest.fitness.config.ts",
    "test:all": "vitest run",
    "lint": "tsc --noEmit && npm run lint --workspace @my-agent/copilot-relay-provider",
    "prepack": "npm run build",
    "agent": "npx tsx src/hosts/standalone/entry.ts",
    "verify:host-build": "node scripts/audit-host-build.mjs",
    "verify:package": "node scripts/verify-npm-package.mjs",
    "verify:relay": "npm run test --workspace @my-agent/copilot-relay-provider",
    "verify:websocket-host": "node scripts/verify-websocket-host.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@xenova/transformers": "^2.17.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.8.0",
    "jiti": "^2.7.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  }
}
