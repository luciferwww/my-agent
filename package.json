{
  "name": "my-agent",
  "version": "0.1.0",
  "description": "Personal AI Agent for learning purposes — exploring prompt building, workspace management, and agent architecture patterns",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "agent:websocket": "npx tsx scripts/websocket.ts",
    "test:tool:list-cwd": "npx tsx scripts/test-exec-list-cwd.ts",
    "test:tool:background": "npx tsx scripts/test-exec-background.ts",
    "test:tool:yield": "npx tsx scripts/test-exec-yield.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@xenova/transformers": "^2.17.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.8.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  }
}
