{
  "manifestVersion": 1,
  "id": "copilot-relay-provider",
  "name": "Copilot Relay Provider",
  "version": "0.1.0",
  "entry": "entry.ts",
  "contributes": ["provider"],
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseURL": {
        "type": "string",
        "default": "http://127.0.0.1:5000"
      },
      "apiKey": {
        "type": "string",
        "writeOnly": true
      },
      "discoveryTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "default": 5000
      }
    }
  }
}
